# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard › Project Settings › API). Never commit .env.local.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The PUBLISHABLE key (starts with sb_publishable_…) or the legacy "anon" key.
# These are designed to be public. Do NOT use the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: the public address of the website, used in email links.
# Leave empty locally (the site uses the address you opened it with).
NEXT_PUBLIC_SITE_URL=
